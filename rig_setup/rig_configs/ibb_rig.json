{
  "name": "IBB Rig",
  "schema_version": 2,
  "calibration_file": "ibb_cal.yaml",
  "patch_file": "ibb_patch.yaml",
  "calibration": {
    "pipette_detector_model": "pipette-small.onnx",
    "pipette_focuser_model": "regression_model2.onnx"
  },
  "ai_features": {
    "enabled": true
  },
  "devices": {
    "stage_controller": {
      "class": "patcherbot.devices.manipulator.scientificaSerial.ScientificaSerialNoEncoder",
      "params": {
        "serial": { "port": "COM7", "baudrate": 9600, "timeout": 1 },
        "max_speed": 100000,
        "max_accel": 1000,
        "polling_freq": 100
      }
    },
    "pipette_controller": {
      "class": "patcherbot.devices.manipulator.sensapexWrapper.SensapexManip",
      "params": { "deviceID": null, "max_speed": 5000, "max_acceleration": 1, "poll_hz": 100.0 }
    },
    "camera": {
      "class": "patcherbot.devices.camera.pcocamera.PcoCamera",
      "params": { "width": 1280, "height": 1280 }
    },
    "pipette_camera": {
      "class": "patcherbot.devices.camera.camera.FakeCamera",
      "params": { "image_z": 0, "paramecium": false }
    },
    "cell_sorter_controller": {
      "class": "patcherbot.devices.cellsorter.CellSorter.FakeCellSorterController",
      "params": {}
    },
    "cell_sorter_manipulator": {
      "class": "patcherbot.devices.cellsorter.CellSorter.FakeCellSorterManip",
      "params": {}
    },
    "daq": {
      "class": "patcherbot.devices.amplifier.DAQ.NiDAQ",
      "params": {
        "readDev": "cDAQ1Mod3",
        "readChannel": "ai7",
        "cmdDev": "cDaq1Mod1",
        "cmdChannel": "ao1",
        "respDev": "cDaq1Mod3",
        "respChannel": "ai0"
      }
    },
    "amplifier": {
      "class": "patcherbot.devices.amplifier.multiclamp.MultiClampChannel",
      "params": { "channel": 1 }
    },
    "pressure": {
      "class": "patcherbot.devices.pressurecontroller.WaynesboroPressureController.WaynesBoroPressureController",
      "params": {
        "channel": 1,
        "controllerSerial": { "port": "COM5", "baudrate": 9600, "timeout": 0 },
        "readerSerial": { "port": "COM4", "baudrate": 9600, "timeout": 0 },
        "validProducts": ["USB Serial"],
        "validVIDs": [6790, 1027],
        "serialCmdTimeout": 1.0
      }
    },
    "lamp": {
      "class": "patcherbot.devices.lamp.lumencor.Lumencore",
      "params": {
        "com": {
          "port": "COM6",
          "baudrate": 9600,
          "timeout": 1,
          "stopbits": 1,
          "parity": "N",
          "bytesize": 8
        }
      }
    }
  }
}
